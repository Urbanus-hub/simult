# Server Configuration
NODE_ENV=development
PORT=5000

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/simult

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# SMTP Email Configuration (Optional - for sending invitations)
# For Gmail: smtp.gmail.com, 587
# For development, you can leave these blank and emails won't be sent
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@simult.com

# Note: For Gmail, you need to use an App Password
# Enable 2FA and generate an app password at: https://myaccount.google.com/apppasswords
